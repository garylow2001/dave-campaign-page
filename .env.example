# Copy to .env.local and fill in real values. .env.local is gitignored.
# Docs: https://github.com/garylow2001/dave-campaign-page

# Google Apps Script web-app URL. After deploying (see apps-script/README.md),
# paste the /exec URL here. Leave empty to run with the save disabled.
VITE_SHEETS_ENDPOINT=

# Shared secret. Must match the token you hardcode into the Apps Script.
VITE_SHEETS_TOKEN=

# Calendly embed URL, e.g. https://calendly.com/yourname/15min
VITE_CALENDLY_URL=

# "true" shows the incentive banner on the result page.
VITE_SHOW_INCENTIVE=false
